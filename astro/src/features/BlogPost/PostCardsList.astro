---
import { type BlogPost } from '../../utils/getPosts';
import { getBlogPostLink } from '../../utils/links';

type Props = {
	posts: BlogPost[];
};

const { posts } = Astro.props;
---

<ul>
	{
		posts.map((post) => (
			<li>
				<a href={getBlogPostLink(post.id)} class="postLink">
					{post.data.image && <img {...post.data.image} />}

					<div class="postBody">
						<h4 class="postTitle">{post.data.title}</h4>

						<div class="postText">{post.previewText}</div>
					</div>
				</a>
			</li>
		))
	}
</ul>

<style>
	ul {
		display: flex;
		flex-direction: column;
		gap: 12px;

		margin: 0;
		padding: 0;
	}

	ul > li {
		list-style: none;
	}

	.postLink {
		display: flex;
		flex-direction: row;
		justify-content: space-between;
		gap: 1rem;
		border: 1px solid;
		border-radius: 8px;
		padding: 1rem;
		background-color: #fffdfb;
		border: 1px solid #bab2ae;

		font-size: 16px;
		color: #000;
		text-decoration: none;

		@media (max-width: 600px) {
			flex-direction: column;
		}
	}

	.postLink img {
		width: 200px;
		height: fit-content;
		border-radius: 8px;
		overflow: hidden;
		aspect-ratio: 5/3;
		object-fit: cover;
		order: 1;
		flex-shrink: 0;
		background: #000;

		@media (max-width: 600px) {
			width: 100%;
			order: unset;
		}
	}

	.postTitle,
	.postText,
	.postLink,
	.postBody {
		text-decoration: none;
		&:hover,
		&:focus-visible {
			text-decoration: none;
		}
	}
</style>
